# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values:
#     Copy-Item .env.example .env
#
# .env is git-ignored. NEVER commit real secrets, and never put a real Binance
# key in this example file.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=Crypto Auto-Trading Backend
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- PostgreSQL ------------------------------------------------------------
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
# A bare "postgresql://" is accepted too and rewritten to use asyncpg.
# If your password contains @ : / or #, percent-encode it (@ -> %40).
DATABASE_URL=postgresql+asyncpg://crypto_user:crypto_password@localhost:5432/crypto_trader
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
# Set true to log every SQL statement (noisy; useful while learning).
DB_ECHO=false

# --- JWT -------------------------------------------------------------------
# Generate a real one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 characters. Changing it invalidates every issued token.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- TradingView webhook ---------------------------------------------------
# Shared secret the webhook caller must present, either as the header
#   X-Webhook-Secret: <value>
# or, for TradingView alerts (which cannot send custom headers), as a
# "secret" field inside the JSON body. Minimum 16 characters.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=REPLACE_WITH_A_RANDOM_STRING_AT_LEAST_16_CHARS

# Trades created by the webhook are attributed to this account. Register it
# first via POST /auth/register, or the webhook returns a 500 configuration
# error.
WEBHOOK_TRADE_OWNER_EMAIL=trader@example.com

# --- Binance SPOT TESTNET (never production) -------------------------------
# Get keys from https://testnet.binance.vision (log in with GitHub, then
# "Generate HMAC_SHA256 Key"). These are testnet-only keys with no real value,
# but still treat them as secrets.
BINANCE_API_KEY=your_testnet_api_key_here
BINANCE_SECRET_KEY=your_testnet_secret_key_here

# The application REFUSES TO START unless this is a Binance testnet host.
# There is no override flag - see ALLOWED_BINANCE_HOSTS in app/core/config.py.
BINANCE_BASE_URL=https://testnet.binance.vision

BINANCE_TIMEOUT_SECONDS=10
BINANCE_RECV_WINDOW_MS=5000

# true  -> POST /api/v3/order/test : validates the order, creates nothing.
# false -> POST /api/v3/order      : places a real order on the TESTNET.
# Start with true for your first smoke test.
BINANCE_DRY_RUN=true

# --- Webhook execution model ----------------------------------------------
# true  = the webhook commits the PENDING trade, hands the exchange call to the
#         in-process executor, and returns 202 in a few milliseconds.
# false = the exchange call happens inside the request; the caller waits for
#         the final trade status. This is the benchmark's "before" baseline.
# Idempotency, the PENDING state, reconciliation and recovery are identical
# in both modes.
WEBHOOK_ASYNC_EXECUTION=true
# Concurrent exchange calls in flight.
EXECUTOR_WORKERS=8
# Bounded queue: a full queue logs a warning and leaves the trade PENDING,
# which the next startup re-queues. It is never silently dropped.
EXECUTOR_QUEUE_SIZE=1000

# --- Trading safety limits -------------------------------------------------
ALLOWED_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT
MIN_ORDER_QUANTITY=0.00001
MAX_ORDER_QUANTITY=1.0
